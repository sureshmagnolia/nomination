# ==========================================
# GVC College Union Election Portal - Environment Variables
# ==========================================

# 1. Database Connection String (Required)
# Host your PostgreSQL database on Neon (recommended: https://neon.tech), Supabase, or Vercel Postgres.
# Must include sslmode=require for secure serverless connections.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Resend API Key for Admin 2FA / OTP Emails (Required for Production)
# Create a free API key at https://resend.com
# Used to send secure 6-digit login codes to the Returning Officer / Election Administrator.
RESEND_API_KEY=re_your_resend_api_key_here
